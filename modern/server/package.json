{
  "name": "@f2b-shop-modern/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "node --test dist/**/*.test.js",
    "test:api": "node --test dist/catalogue/api.integration.js",
    "db:preflight": "node dist/scripts/db-preflight.js",
    "db:seed": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "5.1.0",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "express-rate-limit": "7.5.1",
    "express-session": "1.18.2",
    "helmet": "8.1.0",
    "mongoose": "8.16.1",
    "node-sql-parser": "5.4.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.2",
    "@types/node": "22.15.32",
    "eslint": "9.28.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.34.1"
  }
